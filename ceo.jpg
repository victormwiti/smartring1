<!DOCTYPE html>
<html>
<head>
<title>Market | SMART RING</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="bg-black text-white">

<nav class="p-6">
<a href="../">← Home</a>
</nav>

<section class="pt-32 max-w-4xl mx-auto px-6 text-center">

<h1 class="text-5xl mb-10">Market Opportunity</h1>

<p class="text-gray-400 mb-16">
Global visual impairment exceeds 2.2 billion people.
Kenya alone has up to 1.9 million visually impaired individuals.
</p>

<canvas id="marketGraph"></canvas>

</section>

<script>
new Chart(document.getElementById("marketGraph"),{
type:"line",
data:{
labels:["2025","2026","2027"],
datasets:[{
label:"Projected Users",
data:[2000,6000,10000],
borderWidth:2
}]
},
options:{
responsive:true,
animation:{duration:2000}
}
});
</script>

</body>
</html>w